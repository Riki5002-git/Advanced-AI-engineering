# Copy this file to .env and fill in. The .env file is never shared and never goes to git.

# Langfuse → Settings → API Keys → Create new API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region (the default). For a US project: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# sim = the simulated model (free). anthropic = the real Claude API.
LLM_BACKEND=sim
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
